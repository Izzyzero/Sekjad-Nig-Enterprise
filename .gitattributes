# Keep text files consistent across Windows, macOS, and Linux.
* text=auto eol=lf

# Preserve Windows command script line endings.
*.bat text eol=crlf
*.cmd text eol=crlf

# Do not attempt line-ending conversion for binary assets.
*.gif binary
*.ico binary
*.jpg binary
*.jpeg binary
*.png binary
*.webp binary
*.woff binary
*.woff2 binary
